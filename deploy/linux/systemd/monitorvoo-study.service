[Unit]
Description=MonitorVoo: coleta horaria (estudo Colombia + malha Brasil)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=monitorvoo
Group=monitorvoo
WorkingDirectory=/opt/monitorvoo
ExecStart=/opt/monitorvoo/.venv/bin/python -m collectors.study
TimeoutStartSec=55min
Nice=5
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=XDG_CACHE_HOME=/var/cache/monitorvoo
CacheDirectory=monitorvoo

# Isolamento: o processo so escreve em logs/ e raw/, nao enxerga /home,
# nao ganha privilegios e so usa rede IP.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/monitorvoo/logs /opt/monitorvoo/raw
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native
UMask=0077
